{
    "manifest_version": 3,
    "name": "Mac AutoScroll",
    "version": "1.7.0",
    "description": "Replica of the AutoScroll feature from chrome on windows for mac and linux",
    "permissions": [
        "storage"
    ],
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "content_scripts": [
        {
          "matches": ["<all_urls>"],
          "js": [
            "js/assets.js",
            "js/overlay.js",
            "js/functions.js",
            "js/settings.js",
            "js/autoscroll.js"
          ]
        }
      ],
     "web_accessible_resources": [
        {
          "resources": ["img/*.svg"],
          "matches": ["<all_urls>"]
        }
     ],
     "icons": {
        "16": "img/16.png",
        "32": "img/32.png",
        "48": "img/48.png",
        "64": "img/64.png",
        "96": "img/96.png",
        "128": "img/128.png"
     }
}
